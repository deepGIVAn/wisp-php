APP_NAME=Wisp

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Bump this on deploy so browsers fetch fresh CSS/JS/images/fonts
ASSET_VERSION=1

# sqlite | mysql
DB_CONNECTION=sqlite
DB_DATABASE=storage/database/app.sqlite

# MySQL (used when DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wisp

DB_USER=root
DB_PASS=

# file cache under storage/cache
CACHE_DRIVER=file
CACHE_TTL=3600
